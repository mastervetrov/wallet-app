# =======================================
# ============ BASE SETTINGS ============
# =======================================

# ============ SPRING BOOT ============
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-wallet:5432/wallet_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_OPEN_IN_VIEW=false

# ============ POSTGRES ============
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet_db

# ============ LIQUIBASE ============
SPRING_LIQUIBASE_ENABLED=true
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/changelog-master.yaml

# ============ HIBERNATE ============
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=1
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_INSERTS=true
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_UPDATES=true

# ============ LOGGING ===============
LOGGING_LEVEL_COMPANY_WALLET=WARN
LOGGING_LEVEL_HIBERNATE_SQL=WARN
LOGGING_LEVEL_SPRING_WEB=WARN
LOGGING_LEVEL_TRANSACTION=WARN

# ===========================================
# ============ ADVANCED SETTINGS ============
# ===========================================

# ============ POSTGRES ============
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_WORKER_PROCESSES=8
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=4
POSTGRES_MAX_PARALLEL_WORKERS=8

# ============ HIKARICP ============
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=100
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=20
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# ============ TOMCAT ============
SERVER_TOMCAT_MAX_THREADS=1000
SERVER_TOMCAT_MIN_SPARE_THREADS=100
SERVER_TOMCAT_MAX_CONNECTIONS=10000

# ============ JVM SETTINGS ============
JVM_XMX=3g
JVM_XMS=3g
JVM_GC_TYPE=G1GC
JVM_GC_PAUSE=200
JVM_MAX_RAM_PERCENTAGE=80.0

# ============ JVM OPTIONS ============
JAVA_TOOL_OPTIONS=-Xmx3g -Xms3g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxRAMPercentage=80.0 -XX:+UseContainerSupport -XX:+AlwaysPreTouch -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8 -Dspring.jmx.enabled=false -Djava.awt.headless=true

